{
  "name": "quiet-garden",
  "version": "0.1.0",
  "description": "Cooperative anti-stress garden for 2-4 players",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "check": "node --check server/index.js && node --check server/handlers.js && node --check server/rooms.js && node --check server/garden.js && node --check server/goals.js && vite build",
    "test": "node --test 'tests/*.test.js'"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.21.2",
    "phaser": "^3.90.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
