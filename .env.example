PORT=3002
# По умолчанию клиент подключается к тому же хосту (same-origin) через /socket.io.
# Задайте VITE_SERVER_URL только если сервер вынесен на отдельный домен.
# VITE_SERVER_URL=https://api.example.com

# Keep-alive: самопинг публичного адреса, чтобы Render не усыплял сервис.
# Интервал в миллисекундах (по умолчанию 600000 = 10 минут).
# KEEP_ALIVE_INTERVAL_MS=600000
# На Render адрес подставляется автоматически через RENDER_EXTERNAL_URL.
# KEEP_ALIVE_URL=https://quiet-garden.onrender.com/health
